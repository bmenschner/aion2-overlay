<Window x:Class="Aion2Overlay.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Overlay · Kartenkalibrierung · v0.2.2"
        Width="1120" Height="760" MinWidth="900" MinHeight="660"
        Background="#101722" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Feste Kartenansicht kalibrieren" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Drei gleiche Landmarken zuordnen, dann zwei weitere Punkte prüfen. Das Aufnahmebild bleibt eingefroren."
                 Foreground="#AAB6C6" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="KARTEN-ID / GEBIET" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="MapIdInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" TextChanged="MetadataChanged" MaxLength="120" AutomationProperties.Name="Karten-ID oder Gebiet"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
        <TextBlock Text="GLOBAL-SPIELBUILD" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="BuildInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" TextChanged="MetadataChanged" MaxLength="120" AutomationProperties.Name="Global-Spielbuild"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="FESTE ANSICHT (ZOOM, UI-SKALIERUNG, FRAKTION)" FontSize="11" Margin="0,0,0,5"/>
        <TextBox x:Name="ViewInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" TextChanged="MetadataChanged" MaxLength="500" AutomationProperties.Name="Beschreibung der festen Kartenansicht"/>
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,0,0,10">
      <Button x:Name="ReferenceButton" Style="{StaticResource OverlayButtonStyle}" Content="Referenzkarte öffnen" Click="OpenReferenceClick"/>
      <TextBlock x:Name="ReferenceLabel" Text="Lokales PNG-, JPEG- oder BMP-Bild auswählen · Europa/Global"
                 VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#AAB6C6"/>
    </DockPanel>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="+" Click="ReferenceZoomIn" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Referenzbild vergrößern"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="−" Click="ReferenceZoomOut" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Referenzbild verkleinern"/>
        <TextBlock x:Name="ReferenceZoomLabel" DockPanel.Dock="Right" Text="1×" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock Text="1 · REFERENZKARTE" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Grid.Column="2" Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="+" Click="CaptureZoomIn" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Aufnahmebild vergrößern"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="−" Click="CaptureZoomOut" Padding="8,2" Margin="4,0,0,0" AutomationProperties.Name="Aufnahmebild verkleinern"/>
        <TextBlock x:Name="CaptureZoomLabel" DockPanel.Dock="Right" Text="1×" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock x:Name="CaptureLabel" Text="2 · AUFNAHMEBILD" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <Border Grid.Row="1" Background="#080D14" BorderBrush="#435165" BorderThickness="1" CornerRadius="4" Padding="1">
        <ScrollViewer x:Name="ReferenceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" ScrollChanged="ViewportChanged" PreviewMouseWheel="ReferenceWheel">
        <Grid x:Name="ReferenceHost" Width="1" Height="1" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="ReferenceClick" SizeChanged="ImageSizeChanged" Cursor="Cross">
          <Image x:Name="ReferenceImage" Stretch="Uniform"/>
          <TextBlock x:Name="ReferenceEmpty" Text="Zuerst eine Referenzkarte öffnen" Foreground="#AAB6C6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Canvas x:Name="ReferenceMarks" IsHitTestVisible="False"/>
        </Grid>
        </ScrollViewer>
      </Border>
      <Border Grid.Row="1" Grid.Column="2" Background="#080D14" BorderBrush="#435165" BorderThickness="1" CornerRadius="4" Padding="1">
        <ScrollViewer x:Name="CaptureScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" ScrollChanged="ViewportChanged" PreviewMouseWheel="CaptureWheel">
        <Grid x:Name="CaptureHost" Width="1" Height="1" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="CaptureClick" SizeChanged="ImageSizeChanged" Cursor="Cross">
          <Image x:Name="CaptureImage" Stretch="Uniform"/>
          <Canvas x:Name="CaptureMarks" IsHitTestVisible="False"/>
        </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,12,0,12">
      <TextBlock x:Name="StepText" Text="Zuerst eine Referenzkarte öffnen." FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="ResultText" Text="Noch keine Kalibrierung." Foreground="#AAB6C6" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="Bilder vergrößern: + oder Mausrad · Ausschnitt bewegen: Scrollleisten. Die Ingame-Karte unverändert lassen."
                 Foreground="#AAB6C6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="Nur für diese feste Ingame-Ansicht. Nach Karten-/Zoomwechsel im Spiel neu kalibrieren. Noch keine Live-Cube-Marker."
                 Foreground="#AAB6C6" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <DockPanel Grid.Row="5">
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="Kalibrierung speichern" IsEnabled="False" Click="SaveClick" Margin="8,0,0,0"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="UndoButton" Style="{StaticResource OverlayButtonStyle}" Content="Letztes Paar zurück" IsEnabled="False" Click="UndoClick"/>
        <Button x:Name="ResetButton" Style="{StaticResource OverlayButtonStyle}" Content="Neu beginnen" Click="ResetClick"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
