<Window x:Class="Aion2Overlay.App.AutomaticRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Overlay · Automatischer Kartenabgleich · v0.4.2"
        Width="1120" Height="730" MinWidth="880" MinHeight="560"
        Background="#101722" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="Kartenbilder automatisch abgleichen" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Referenz öffnen und Abgleich starten. Keine Referenzpunkte anklicken." Foreground="#AAB6C6" Margin="0,6,0,0"/>
      <TextBlock x:Name="CaptureTimeText" Foreground="#AAB6C6" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Button x:Name="ReferenceButton" Style="{StaticResource OverlayButtonStyle}" Content="Referenzkarte öffnen" Click="OpenReferenceClick"/>
      <Button x:Name="MatchButton" Style="{StaticResource OverlayButtonStyle}" Content="Automatisch abgleichen" Click="MatchClick" IsEnabled="False"/>
      <Button x:Name="CancelButton" Style="{StaticResource OverlayButtonStyle}" Content="Abbrechen" Click="CancelClick" IsEnabled="False"/>
      <Button x:Name="LoadButton" Style="{StaticResource OverlayButtonStyle}" Content="Profil öffnen" Click="LoadProfileClick"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ReferenceLabel" Text="1 · REFERENZKARTE" FontSize="11" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="2" x:Name="CaptureLabel" Text="2 · EINGEFRORENE AUFNAHME" FontSize="11" Margin="0,0,0,6"/>
      <Border Grid.Row="1" Background="#080D14" BorderBrush="#435165" BorderThickness="1" CornerRadius="4">
        <Grid><Image x:Name="ReferenceImage" Stretch="Uniform"/><TextBlock x:Name="ReferenceEmpty" Text="Zuerst eine Referenzkarte öffnen" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="2" Background="#080D14" BorderBrush="#435165" BorderThickness="1" CornerRadius="4">
        <Image x:Name="CaptureImage" Stretch="Uniform"/>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,12,0,10">
      <TextBlock x:Name="StatusText" Text="Zuerst eine Referenzkarte öffnen." FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="QualityText" Foreground="#AAB6C6" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <CheckBox x:Name="OverlayCheck" Content="Geprüfte Überlagerung anzeigen" Foreground="White" IsChecked="True" IsEnabled="False" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="0,8,0,0"/>
    </StackPanel>
    <Expander Grid.Row="4" Header="Gebiet und Spielversion (optional, ungeprüft)" Foreground="White" Margin="0,0,0,10">
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBox x:Name="MapIdInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" MaxLength="120" Margin="0,0,8,0" ToolTip="Karten-ID / Gebiet" AutomationProperties.Name="Karten-ID oder Gebiet"/>
        <TextBox Grid.Column="1" x:Name="BuildInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" MaxLength="120" Margin="0,0,8,0" ToolTip="Global-Spielbuild, falls bekannt" AutomationProperties.Name="Global-Spielbuild"/>
        <TextBox Grid.Column="2" x:Name="ViewInput" Foreground="Black" Background="#F6F7FA" Padding="8,6" MaxLength="500" ToolTip="Ansichtsnotiz" AutomationProperties.Name="Ansichtsnotiz"/>
      </Grid>
    </Expander>
    <DockPanel Grid.Row="5">
      <Button x:Name="LiveButton" DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="Live-Zuordnung starten" Click="LiveClick" IsEnabled="False" Margin="8,0,0,0"/>
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource OverlayButtonStyle}" Content="Zuordnung speichern" Click="SaveClick" IsEnabled="False" Margin="8,0,0,0"/>
      <TextBlock Text="Nur für dieses Aufnahmebild und den geprüften Bereich. Noch keine Live-Cube-Marker." Foreground="#AAB6C6" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
