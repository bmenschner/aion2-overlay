<Window x:Class="Aion2Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Overlay · Fensteraufnahme · v0.1.2" Width="940" Height="720" MinWidth="720" MinHeight="600"
        Background="#101722" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="AION 2 / OVERLAY" Foreground="#E4B96A" FontSize="12" FontWeight="Bold" />
      <TextBlock Text="Fenster verbinden" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,6" />
      <TextBlock Text="Wähle dein Spielfenster. Die Vorschau zeigt die Aufnahme; der Rahmen hilft beim Ausrichten."
                 Foreground="#AAB6C6" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18">
      <StackPanel>
        <TextBlock Text="SPIELFENSTER" FontSize="11" Foreground="#AAB6C6" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ComboBox x:Name="WindowSelector" DisplayMemberPath="Label" Padding="10,8" FontSize="14"
                    AutomationProperties.Name="Aufzunehmendes Fenster" />
          <Button x:Name="RefreshButton" Style="{StaticResource OverlayButtonStyle}" Grid.Column="1" Content="Aktualisieren" Click="RefreshClick" Margin="12,0,0,0" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="StartButton" Style="{StaticResource OverlayButtonStyle}" Content="Aufnahme starten" Click="StartClick" />
          <Button x:Name="StopButton" Style="{StaticResource OverlayButtonStyle}" Content="Stoppen" Click="StopClick" IsEnabled="False" Background="#D5DCE6" />
          <CheckBox x:Name="AlignmentCheck" Content="Ausrichtungsrahmen anzeigen" IsChecked="True"
                    VerticalAlignment="Center" Foreground="#E7EBF1" Margin="12,0,0,0"
                    Checked="AlignmentChanged" Unchecked="AlignmentChanged" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,18,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="AUFNAHMEVORSCHAU" FontSize="11" Foreground="#AAB6C6" />
      <TextBlock x:Name="FrameInfo" Grid.Column="1" Text="Noch kein Bild" FontSize="11" Foreground="#AAB6C6" />
    </Grid>
    <Border Grid.Row="3" Background="#080D14" BorderBrush="#2B394B" BorderThickness="1" CornerRadius="10" Padding="8">
      <Grid>
        <Image x:Name="Preview" Stretch="Uniform" />
        <TextBlock x:Name="EmptyPreview" Text="Die Vorschau erscheint nach dem Start."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#738297" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Text="Bereit. Wähle ein Fenster aus." TextWrapping="Wrap" />
      <TextBlock Text="Europa / Global · Randloses Fenster · v0.1.2 · Cube-Markierungen folgen im nächsten Schritt"
                 Foreground="#738297" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
