<Window x:Class="Aion2Overlay.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aion 2 Overlay · Ausrichtung"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Left="-20000" Top="-20000" Width="100" Height="100"
        IsHitTestVisible="False">
  <Grid IsHitTestVisible="False">
    <Border x:Name="AlignmentBorder" BorderBrush="#E4B96A" BorderThickness="2" Margin="3" />
    <Border x:Name="AlignmentLabel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
            Background="#DC111923" CornerRadius="6" Padding="12,8">
      <StackPanel>
        <TextBlock Text="AION 2 · OVERLAY-TEST" Foreground="#E4B96A" FontWeight="Bold" FontSize="13" />
        <TextBlock Text="Clientbereich · keine Cube-Daten" FontSize="11" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
    <Grid x:Name="AlignmentCross" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Height="2" Background="#E4B96A" VerticalAlignment="Center" />
      <Border Width="2" Background="#E4B96A" HorizontalAlignment="Center" />
    </Grid>
    <Canvas x:Name="LiveCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
  </Grid>
</Window>
